{
    "name": "technest",
    "private": true,
    "workspaces": [
        "apps/*",
        "server"
    ],
    "scripts": {
        "store": "npm run dev --workspace=apps/store",
        "chatbot": "npm run dev --workspace=apps/chatbot",
        "server": "npm run dev --workspace=server",
        "dev": "concurrently \"npm run store\" \"npm run chatbot\" \"npm run server\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
